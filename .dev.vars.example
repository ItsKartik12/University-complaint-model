# ==============================================================================
# ACICS — Cloudflare Worker Local Environment (.dev.vars.example)
# ==============================================================================
# Copy this file to .dev.vars for local development with Miniflare/Wrangler.
# Values in this file are injected into the Cloudflare Worker environment (c.env).

APP_ENV=development
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Optional: Enterprise OIDC Identity Provider (Freebuff)
# When set, Freebuff handles authentication. When unset, ACICS uses built-in email/password.
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=https://freebuff.com/oidc

# Google OAuth Integration (configure when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# First-administrator bootstrap (optional; set once, then remove the password).
# The worker creates the ADMIN account only while no administrator exists.
# There is no administrator-registration HTTP endpoint. Quote any value that
# contains '#', otherwise it is treated as a comment.
# ACICS_BOOTSTRAP_ADMIN_EMAIL=you@institution.ac.in
# ACICS_BOOTSTRAP_ADMIN_NAME="Your Name"
# ACICS_BOOTSTRAP_ADMIN_PASSWORD="a-strong-password-at-least-12-chars"
