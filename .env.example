# ==============================================================================
# ACICS — Environment Variables Template (.env.example)
# ==============================================================================

# Application environment ('development' | 'production' | 'test')
APP_ENV=development
APP_NAME=ACICS

# Authentication mode for the Worker ('mock' | 'development' | 'off').
# 'mock' requires APP_ENV=development and a loopback origin; production always
# disables synthetic access regardless of this value.
AUTH_MODE=mock

# Frontend public configuration (Vite exposed variables; NEVER place secrets here).
# Keep the API base same-origin; the Cloudflare Vite plugin serves the Worker and
# the React app from one origin, so no backend port needs to be hardcoded.
VITE_API_BASE_URL=/api
VITE_APP_NAME=ACICS

# Backend & Security Configuration
# Local Worker variables also live in .dev.vars (copy .dev.vars.example there).
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
LOG_LEVEL=debug

# Database Configuration:
# ACICS uses Cloudflare D1 (SQLite) distributed database binding (c.env.DB).
# Locally, Miniflare emulates D1 automatically via bun run dev.
# In production, Cloudflare provisions D1 via wrangler configuration.
# (DATABASE_URL is not needed for native Cloudflare D1 bindings).

# Google OAuth Configuration (leave as placeholders until OAuth credentials are provided):
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
