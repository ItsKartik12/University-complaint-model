# Frontend (Vite) public configuration — safe to ship to the browser.
# These VITE_* values are loaded from the repository root (Vite's envDir default),
# so copy them into the root .env file. Never put secrets in VITE_* variables.
#
# Leave VITE_API_BASE_URL as /api so the client always talks to the same origin
# that serves it. Do not hardcode a backend port; the Cloudflare Vite plugin
# runs the Worker and the React app in one runtime.
VITE_API_BASE_URL=/api
VITE_APP_NAME=ACICS
